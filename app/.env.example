# =============================================================================
# AudioBlocks for Artist — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Required variables are marked with [REQUIRED].
# =============================================================================

# ─── API Configuration ───────────────────────────────────────────────────────

# Base URL for the backend API [REQUIRED]
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Base URL for the listener/fan-facing app (used for referral links)
NEXT_PUBLIC_LISTENER_APP_URL=https://audioblocks.io

# ─── Privy Authentication ────────────────────────────────────────────────────

# Privy App ID for Web3 authentication [REQUIRED for artist portal]
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Privy App Secret for server-side authentication [REQUIRED for API routes]
PRIVY_APP_SECRET=your-privy-app-secret

# ─── Analytics ───────────────────────────────────────────────────────────────

# Segment (or compatible) write key for analytics [REQUIRED]
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=your-analytics-write-key

# Optional endpoint that receives Core Web Vitals beacons in production.
# When unset, production metrics are logged to the console instead.
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=https://api.example.com/web-vitals

# ─── Feature Flags ───────────────────────────────────────────────────────────

# Use mock data instead of real API calls (true/false) [REQUIRED]
NEXT_PUBLIC_USE_MOCK_DATA=false

# ─── Stellar Network ─────────────────────────────────────────────────────────

# Stellar network passphrase (Test SDF Network ; September 2015 for testnet)
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Custom Stellar RPC/Horizon URL (optional, defaults to public endpoint)
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ─── Base URL ────────────────────────────────────────────────────────────────

# Public base URL for metadata and canonical links
# NEXT_PUBLIC_BASE_URL=https://audioblocks.io

# ─── Server-Side Only ────────────────────────────────────────────────────────

# Node environment (development/production/test) — set by Next.js automatically
# NODE_ENV=development
