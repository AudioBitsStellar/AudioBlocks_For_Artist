# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL for the AudioBlocks backend API (required)
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Dynamic Labs environment ID for wallet-based authentication (required)
NEXT_PUBLIC_DYNAMIC_ENV_ID=your-dynamic-env-id

# ─── Blockchain / Stellar ─────────────────────────────────────────────────────
# Stellar network passphrase (required for on-chain features)
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar RPC / Horizon URL (required for on-chain features)
NEXT_PUBLIC_STELLAR_RPC_URL=https://horizon-testnet.stellar.org

# ─── Analytics ────────────────────────────────────────────────────────────────
# Write key for analytics tracking (optional)
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to use mock data instead of real API calls (optional, default: false)
NEXT_PUBLIC_USE_MOCK_DATA=false
