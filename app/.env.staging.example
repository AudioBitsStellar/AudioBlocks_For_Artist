# =============================================================================
# AudioBlocks for Artist — Staging Environment Variables (OPS-03)
# =============================================================================
# Targets the backend testnet environment and Stellar Soroban Testnet.
# =============================================================================

# ─── API Configuration (Backend Testnet) ──────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.testnet.audioblocks.io
NEXT_PUBLIC_LISTENER_APP_URL=https://testnet.audioblocks.io

# ─── Privy Authentication ────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=your-staging-privy-app-id
PRIVY_APP_SECRET=your-staging-privy-app-secret

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=staging-analytics-key
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=https://api.testnet.audioblocks.io/web-vitals

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Staging validates real API responses — mock data MUST be false (OPS-03)
NEXT_PUBLIC_USE_MOCK_DATA=false
# Supply NEXT_PUBLIC_FEATURE_FLAGS as a container/runtime environment variable,
# not as a build argument, so the same image can be promoted across environments.
# Example kill switch: NEXT_PUBLIC_FEATURE_FLAGS=artistOnchainAnalytics=false

# ─── Stellar Soroban Testnet ─────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# ─── Canonical Host & Base URL ───────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://staging.artists.audioblocks.io
CANONICAL_HOST=staging.artists.audioblocks.io

# ─── Observability ───────────────────────────────────────────────────────────
NODE_ENV=production
SENTRY_ENVIRONMENT=staging
