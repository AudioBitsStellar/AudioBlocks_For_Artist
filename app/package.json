{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=20.18.0 <21.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "chromatic": "chromatic --project-id audio-blocks",
    "prepare": "cd .. && (husky app/.husky || true)",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:types:check": "node scripts/generate-api-types.mjs --check",
    "api:fixtures:check": "node scripts/validate-openapi-fixtures.mjs",
    "api:spec:check": "node scripts/check-openapi-drift.mjs",
    "perf:budgets": "node scripts/check-performance-budgets.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.3.0",
    "@privy-io/react-auth": "^3.52.1",
    "@privy-io/server-auth": "^1.32.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.78.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-base": "^15.0.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "@tanstack/react-query": "^5.90.6",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.1",
    "framer-motion": "^12.23.24",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.548.0",
    "next": "16.1.5",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.0",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.1.2",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "web-vitals": "^3.5.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/nextjs-vite": "^9.1.20",
    "@storybook/react": "^9.1.20",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.9.18",
    "chromatic": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "storybook": "^9.1.20",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.0",
    "vitest-axe": "0.1.0",
    "yaml": "^2.9.0"
  }
